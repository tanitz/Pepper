{
  "name": "Pepper Linux",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  "workspaceFolder": "/workspaces/Pepper",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "upgradePackages": false
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },

  // Prefer NVIDIA GPU when the host has one (NVIDIA driver + nvidia-container-toolkit).
  // On CPU-only hosts this is ignored; remove runArgs if container start fails without a GPU.
  "hostRequirements": {
    "gpu": "optional"
  },
  // NOTE: --device=/dev/snd passes the host's ALSA sound card into the
  // container. It only works on Linux hosts that actually have /dev/snd —
  // docker errors out at container start if the path doesn't exist, so it
  // is NOT enabled unconditionally (this container also runs on hosts
  // without a card, e.g. macOS/cloud, where audio falls back to the SDL
  // dummy driver). On a Linux box with a real card, uncomment the device
  // line below. postStartCommand chmods the node so the "vscode" user can
  // access it regardless of the host's "audio" group gid.
  "runArgs": [
    "--gpus", "all"
    // , "--device=/dev/snd"
  ],
  "postStartCommand": "sudo chmod a+rw /dev/snd/* 2>/dev/null || true",

  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Pepper tablet HTTP",
      "onAutoForward": "notify"
    }
  },

  "containerEnv": {
    "PYTHONPATH": "/workspaces/Pepper/SDK_pynaoqi/linux64/lib/python2.7/site-packages",
    "LD_LIBRARY_PATH": "/workspaces/Pepper/SDK_pynaoqi/linux64/lib",
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "compute,utility"
  },

  "postCreateCommand": "bash -c 'find .devcontainer bin/setup -name \"*.sh\" -print0 | xargs -0 sed -i \"s/\\r$//\"; bash .devcontainer/post-create.sh'",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3.11",
        "python.terminal.activateEnvironment": false,
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.eol": "\n"
      }
    }
  },

  "remoteUser": "vscode"
}
